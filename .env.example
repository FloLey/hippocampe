# Copy to .env and fill in. Never commit the .env file.

# The domain pointing at your server, and the same as a URL.
WIKI_DOMAIN=memoire.example.com
WIKI_PUBLIC_URL=https://memoire.example.com

# Your GitHub login: the only account allowed in.
WIKI_ALLOWED_GITHUB_LOGIN=your-github-login

# The GitHub OAuth app (README, "GitHub OAuth app").
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

# Any long random value, so logins survive restarts: openssl rand -hex 32
WIKI_JWT_SIGNING_KEY=

# For the nightly dream (console.anthropic.com). Everything else works without it.
ANTHROPIC_API_KEY=

# Key of the secrets vault. Generate it once and keep a copy somewhere safe:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WIKI_VAULT_KEY=

# Optional: your first name, used in the dream prompts.
WIKI_OWNER_NAME=
